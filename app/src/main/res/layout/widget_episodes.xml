<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical" android:gravity="center_vertical" android:contentDescription="@string/widget_open_label">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STREAMWISE" android:fontFamily="sans-serif-black" android:letterSpacing="0.12" android:textColor="#FF5964" android:textSize="11sp" android:maxLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_episodes_label" android:fontFamily="sans-serif-black" android:textColor="#F7F5F3" android:textSize="19sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="10dp" android:scaleType="fitCenter" android:background="@drawable/widget_refresh_background" android:src="@drawable/ic_refresh" android:tint="#F7F5F3" android:contentDescription="@string/widget_refresh_label" />
    </LinearLayout>
    <ListView android:id="@+id/widget_episodes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:scrollbars="none" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_card" android:padding="16dp" android:text="@string/widget_empty_label" android:textColor="#A4A8B5" android:textSize="14sp" android:lineSpacingExtra="3dp" />
</LinearLayout>
