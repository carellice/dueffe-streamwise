<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_card">
    <TextView android:id="@+id/widget_series" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F1F2" android:fontFamily="sans-serif-medium" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_episode" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="12dp" android:textColor="#E27A8D" android:textSize="13sp" />
    <TextView android:id="@+id/widget_seen" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:background="@drawable/widget_action_background" android:text="@string/widget_seen_label" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="14sp" />
    <LinearLayout android:id="@+id/widget_reactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <TextView android:id="@+id/widget_like" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/widget_refresh_background" android:text="@string/widget_like_label" android:textSize="13sp" android:textColor="#54D8A2" />
        <TextView android:id="@+id/widget_dislike" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/widget_refresh_background" android:text="@string/widget_dislike_label" android:textSize="13sp" android:textColor="#FF7085" />
    </LinearLayout>
</LinearLayout>
