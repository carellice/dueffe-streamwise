<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreamWise" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#090A0F</item>
        <item name="android:navigationBarColor">#07080C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#E5092F</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Animation.StreamWise.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:windowExitAnimation">@anim/fade_scale_out</item>
    </style>
</resources>
